rules_version = '2';
// FinCon — regras do Firestore. Copie para o console do Firebase (Firestore → Regras) sempre que mudar.
// Vários lugares independentes: cada documento de dados tem o campo "lugar"; a configuração fica em config/{lugar}.
// Perfis (users/{uid}.perfil):
//   "adm" — administrador global: cria lugares e usuários e pode agir em qualquer lugar;
//   "secretaria" (na tela: cl) — acesso total, mas só ao próprio lugar (users/{uid}.lugar);
//   "residente" — no próprio lugar, lê/grava só os próprios lançamentos e saldos (sigla) e lê os próprios vales;
//   "cr" — global, só consulta: lê configuração, vales, bancos, justificar e fechamentos de todos os lugares.
// Migração (versão de um lugar só): quem fez o primeiro acesso (settings/bootstrap) pode virar "adm".
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function eu() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function adm() { return logado() && eu().perfil == 'adm'; }
    function cr() { return logado() && eu().perfil == 'cr'; }
    function cl(l) { return logado() && eu().perfil == 'secretaria' && eu().lugar == l; }
    function residente(l, s) { return logado() && eu().perfil == 'residente' && eu().lugar == l && s != '' && eu().sigla == s; }
    function fundador() {
      return logado() && exists(/databases/$(database)/documents/settings/bootstrap)
        && get(/databases/$(database)/documents/settings/bootstrap).data.uid == request.auth.uid;
    }

    match /settings/bootstrap {
      allow read: if logado();
      allow create: if logado();                 // só funciona uma vez (transação no app)
    }
    match /lugares/{id} {
      allow read: if logado();
      allow write: if adm();
    }
    match /config/{l} {
      allow read: if adm() || cr() || (logado() && eu().lugar == l);
      allow write: if adm() || cl(l);
    }
    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || adm() || cl(resource.data.lugar));
      allow create: if adm()
        || (logado() && request.auth.uid == uid && !exists(/databases/$(database)/documents/settings/bootstrap)
            && request.resource.data.perfil == 'adm')
        || (cl(request.resource.data.lugar) && request.resource.data.perfil in ['secretaria', 'residente']);
      allow update: if adm()
        || (cl(resource.data.lugar) && cl(request.resource.data.lugar) && request.resource.data.perfil in ['secretaria', 'residente'])
        || (logado() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange']))
        || (request.auth.uid == uid && fundador() && request.resource.data.perfil == 'adm'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perfil', 'lugar']));
      allow delete: if adm() || cl(resource.data.lugar);
    }
    match /lancamentos/{id} {
      allow read: if adm() || cl(resource.data.lugar) || residente(resource.data.lugar, resource.data.sigla);
      allow create: if adm() || cl(request.resource.data.lugar)
        || residente(request.resource.data.lugar, request.resource.data.sigla);
      allow update: if adm() || (cl(resource.data.lugar) && cl(request.resource.data.lugar))
        || (residente(resource.data.lugar, resource.data.sigla) && residente(request.resource.data.lugar, request.resource.data.sigla));
      allow delete: if adm() || cl(resource.data.lugar) || residente(resource.data.lugar, resource.data.sigla);
    }
    match /saldos/{id} {
      allow read: if adm() || cl(resource.data.lugar) || residente(resource.data.lugar, resource.data.sigla);
      allow create, update: if adm() || cl(request.resource.data.lugar)
        || residente(request.resource.data.lugar, request.resource.data.sigla);
      allow delete: if adm() || cl(resource.data.lugar);
    }
    match /vales/{id} {
      allow read: if adm() || cr() || cl(resource.data.lugar) || residente(resource.data.lugar, resource.data.sigla);
      allow create, update: if adm() || cl(request.resource.data.lugar);
      allow delete: if adm() || cl(resource.data.lugar);
    }
    match /{col}/{id} {
      allow read: if col in ['justificar', 'bancos', 'meses'] && (adm() || cr() || cl(resource.data.lugar));
      allow create, update: if col in ['justificar', 'bancos', 'meses'] && (adm() || cl(request.resource.data.lugar));
      allow delete: if col in ['justificar', 'bancos', 'meses'] && (adm() || cl(resource.data.lugar));
    }
  }
}
